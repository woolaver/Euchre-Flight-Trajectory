function optimal_alpha = optimalAlphaMNT(Cp_max)
    %Finds the optimal alpha for best L/D for modified newtonian theory
    
    N = 1000;
    alpha = linspace(0, 40, N);

    CL = zeros([1, N]);
    CD = zeros([1, N]);

    geometry = "HARV.STL";
    S_ref = .029;  

    for i = 1:N
        [CL(i), CD(i), ~, ~, ~, ~, ~] = newtonianCLCD3D(geometry, alpha(i), Cp_max, S_ref);
    end
    L_D = CL ./ CD; % Calculate lift-to-drag ratio
    [~, index] = max(L_D); % Find maximum L/D and its index
    optimal_alpha = alpha(index); % Get the angle of attack for maximum L/D
end